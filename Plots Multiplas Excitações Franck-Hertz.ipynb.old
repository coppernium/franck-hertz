   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import numpy as np\n",
    "from scipy.signal import find_peaks\n",
    "\n",
    "# Caminhos fornecidos\n",
    "caminho_v2 = \"Medidas Multiplas Excitações 150°C (Com fator de escala).xlsx\"\n",
    "caminho_v2_dados = \"Dados experimentais 23.10.2025 (Com fator de escala)/\"\n",
    "\n",
    "# Lê o arquivo principal (com fatores de escala)\n",
    "df_v2 = pd.read_excel(caminho_v2)\n",
    "display(df_v2.head())\n",
    "\n",
    "# Limite de potencial\n",
    "limite_potencial = 22\n",
    "\n",
    "# Lista para armazenar as medidas\n",
    "dados_medidas = []\n",
    "\n",
    "for medida in range(5, 9):\n",
    "    nome_arquivo = f\"m{medida}-m-e-T_150.txt\"\n",
    "    caminho_arquivo = os.path.join(caminho_v2_dados, nome_arquivo)\n",
    "\n",
    "    # Lê o arquivo de dados\n",
    "    df_dados = pd.read_csv(\n",
    "        caminho_arquivo,\n",
    "        sep=r\"\\s+\",\n",
    "        header=None,\n",
    "        names=[\"Potencial (V)\", \"Corrente (uA)\"]\n",
    "    )\n",
    "\n",
    "    # Fator de escala e valor de V2\n",
    "    linha_info = df_v2.loc[df_v2[\"Medida\"] == medida]\n",
    "    escala = linha_info[\"Escala \"].values[0]\n",
    "    v2_valor = linha_info[\"V2 [Volts]\"].values[0]\n",
    "\n",
    "    # Aplica o fator de escala\n",
    "    df_dados[\"Corrente (uA)\"] *= escala\n",
    "\n",
    "    # Filtra até o limite de potencial\n",
    "    df_dados = df_dados[df_dados[\"Potencial (V)\"] <= limite_potencial].reset_index(drop=True)\n",
    "\n",
    "    # Armazena a medida junto com o valor de V2\n",
    "    dados_medidas.append((v2_valor, df_dados))\n",
    "\n",
    "# Calcula min e max globais (correntes filtradas)\n",
    "todas_correntes = np.concatenate([df[\"Corrente (uA)\"].values for _, df in dados_medidas])\n",
    "I_min, I_max = todas_correntes.min(), todas_correntes.max()\n",
    "print(f\"Mínimo global: {I_min:.9f}, Máximo global: {I_max:.9f}\")\n",
    "\n",
    "# --- Configurações visuais ---\n",
    "marcadores = [\"o\", \"s\", \"^\", \"D\", \"v\", \"P\", \"*\"]\n",
    "marcador_vale = \"X\"\n",
    "cor_vale = \"red\"\n",
    "\n",
    "# === FUNÇÃO DE PLOTAGEM ===\n",
    "def plotar_grafico(dados_medidas, mostrar_vales=True):\n",
    "    for i, (v2_valor, df_dados) in enumerate(dados_medidas):\n",
    "        # Normaliza corrente\n",
    "        df_dados[\"Corrente Normalizada\"] = (df_dados[\"Corrente (uA)\"] - I_min) / (I_max - I_min)\n",
    "        V = df_dados[\"Potencial (V)\"].to_numpy()\n",
    "        I = df_dados[\"Corrente Normalizada\"].to_numpy()\n",
    "\n",
    "        # Suavização simples (média móvel)\n",
    "        I_suave = np.convolve(I, np.ones(5)/5, mode='same')\n",
    "\n",
    "        # Parâmetros adaptativos\n",
    "        dist = int(4 * max(20, len(V)//50) * 1.75)  # distância aumentada em 75%\n",
    "        prom = 0.06 * (I.max() - I.min())\n",
    "\n",
    "        # Detecta vales (picos do sinal invertido)\n",
    "        vales, _ = find_peaks(-I_suave, distance=dist, prominence=prom)\n",
    "        vales = vales[V[vales] >= 4.9]\n",
    "\n",
    "        print(f\"Medida {i+1} (V2={v2_valor:.1f} V): {len(vales)} vales encontrados\")\n",
    "\n",
    "        # Plota curva principal\n",
    "        marcador = marcadores[i % len(marcadores)]\n",
    "        plt.plot(\n",
    "            V, I,\n",
    "            label=f\"V2 = {v2_valor:.1f} V\",\n",
    "            marker=marcador,\n",
    "            markevery=50,\n",
    "            linewidth=2.5,\n",
    "            markersize=10\n",
    "        )\n",
    "\n",
    "        if mostrar_vales and len(vales) > 1:\n",
    "            # Marca vales\n",
    "            plt.scatter(\n",
    "                V[vales], I[vales],\n",
    "                color=cor_vale,\n",
    "                s=130,\n",
    "                marker=marcador_vale,\n",
    "                edgecolor=\"black\",\n",
    "                linewidth=1.3,\n",
    "                zorder=5\n",
    "            )\n",
    "\n",
    "            # Adiciona anotações ΔV entre vales consecutivos\n",
    "            for j in range(len(vales) - 1):\n",
    "                x1, x2 = V[vales[j]], V[vales[j + 1]]\n",
    "                y1, y2 = I[vales[j]], I[vales[j + 1]]\n",
    "                delta_V = x2 - x1\n",
    "                x_medio = (x1 + x2) / 2\n",
    "                y_medio = (y1 + y2) / 2\n",
    "\n",
    "                plt.text(\n",
    "                    x_medio,\n",
    "                    y_medio * 1.3,\n",
    "                    f\"ΔV = {delta_V:.2f} V\",\n",
    "                    fontsize=13,\n",
    "                    color=\"black\",\n",
    "                    ha=\"center\",\n",
    "                    va=\"bottom\",\n",
    "                    fontweight=\"bold\",\n",
    "                    bbox=dict(facecolor=\"white\", alpha=0.8, boxstyle=\"round,pad=0.2\")\n",
    "                )\n",
    "\n",
    "    # --- Configurações do gráfico ---\n",
    "    plt.xlabel(\"Potencial (Volts)\")\n",
    "    plt.ylabel(\"Corrente Normalizada\")\n",
    "    titulo = \"Curvas Corrente por Tensão (V2)\"\n",
    "    if mostrar_vales:\n",
    "        titulo += \" — com vales e ΔV\"\n",
    "    else:\n",
    "        titulo += \" — sem vales\"\n",
    "    plt.title(titulo)\n",
    "    plt.yscale('log')\n",
    "    plt.ylim(bottom=2e-4)\n",
    "    plt.grid(True, which='both', linestyle='--', linewidth=0.7)\n",
    "    plt.legend(\n",
    "        title=\"Valores de V2 (Volts)\",\n",
    "        fontsize=14,\n",
    "        title_fontsize=16,\n",
    "        facecolor=\"white\",\n",
    "        framealpha=1.0\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# === GERA OS DOIS GRÁFICOS ===\n",
    "print(\"\\n=== Gráfico COM vales e anotações ===\")\n",
    "plotar_grafico(dados_medidas, mostrar_vales=True)\n",
    "\n",
    "print(\"\\n=== Gráfico SEM vales ===\")\n",
    "plotar_grafico(dados_medidas, mostrar_vales=False)\n"
   ]
  },
