    },
    "executionInfo": {
     "elapsed": 1357,
     "status": "ok",
     "timestamp": 1762278465544,
     "user": {
      "displayName": "Joao Vitor Lima de Oliveira",
      "userId": "06984903289364007619"
     },
     "user_tz": 180
    },
    "id": "oax0hYtUfsre",
    "outputId": "cf6cff99-e60d-4646-b693-d86af82f4c46"
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2000x1200 with 1 Axes>"
      ]
