   "source": [
    "# Aqui eu criei um código que encontra os vales para cada dado experimental obtido"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
